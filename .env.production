# ================================================
# KanpurCabs - Production Environment Configuration
# ================================================
# Update the values below for your live server

# Database (SQLite - local file, no external DB needed)
DATABASE_URL="file:./data/kanpurcabs.db"

# NextAuth Security (CHANGE THIS to a random string!)
NEXTAUTH_SECRET="CHANGE-THIS-TO-A-LONG-RANDOM-SECRET-STRING"

# Your domain URL (update after setting up domain)
NEXTAUTH_URL="https://yourdomain.com"

# Admin login credentials (change password after first login!)
ADMIN_EMAIL="admin@kanpurcabs.com"
ADMIN_PASSWORD="admin123"

# Public site info (update with your actual details)
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
NEXT_PUBLIC_PHONE="+91 98765 43210"
NEXT_PUBLIC_WHATSAPP="+919876543210"
NEXT_PUBLIC_EMAIL="info@kanpurcabs.com"

# Email notifications (optional - configure for booking alerts)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"
# NOTIFICATION_EMAIL="bookings@kanpurcabs.com"
