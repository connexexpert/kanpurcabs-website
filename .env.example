# Environment Variables
# Copy this to .env.local and fill in your values

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="your-super-secret-key-change-this"
NEXTAUTH_URL="http://localhost:3000"

# Admin credentials (used for seeding)
ADMIN_EMAIL="admin@kanpurcabs.com"
ADMIN_PASSWORD="admin123"

# Email (Nodemailer - Gmail SMTP example)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
NOTIFICATION_EMAIL="bookings@kanpurcabs.com"

# Site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_PHONE="+91 98765 43210"
NEXT_PUBLIC_WHATSAPP="+919876543210"
NEXT_PUBLIC_EMAIL="info@kanpurcabs.com"
